#!/bin/sh
# Entry point shim: resolves its own symlinks and execs the Rust binary built
# at <repo>/target/release/task (cargo build --release).
set -eu

self="$0"
while [ -L "$self" ]; do
  dir="$(cd -P "$(dirname "$self")" && pwd -P)" || exit 1
  target="$(readlink "$self")"
  case "$target" in /*) self="$target" ;; *) self="$dir/$target" ;; esac
done
dir="$(cd -P "$(dirname "$self")" && pwd -P)" || { echo "task: cannot resolve CLI path" >&2; exit 1; }
AGENT_TASKS_ROOT="$(cd -P "$dir/.." && pwd -P)"
repo="$(cd -P "$AGENT_TASKS_ROOT/../.." && pwd -P)"
bin="$repo/target/release/task"
if [ ! -x "$bin" ]; then
  echo "task: binary not found at $bin; run 'cargo build --release' in $repo" >&2
  exit 1
fi
export AGENT_TASKS_ROOT
exec "$bin" "$@"
